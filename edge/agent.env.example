# SolarIntel edge agent configuration. Copy to agent.env and edit.

# Where to send samples, and the device token from the Devices page (shown once at registration).
SOLARINTEL_URL=https://your-solarintel-domain
DEVICE_TOKEN=sdt_replace_me

# modbus | mqtt | simulator
SOURCE=modbus
INTERVAL_SECONDS=300

# Upload in batches; samples are buffered to disk while offline and re-sent later.
BATCH_SIZE=200
BUFFER_FILE=./data/buffer.jsonl
BUFFER_MAX_SAMPLES=50000

# --- Modbus TCP (SunSpec inverter model 101/103) ------------------------------------------------------
MODBUS_HOST=192.168.1.50
MODBUS_PORT=502
MODBUS_UNIT_ID=1
# Register addresses are 0-based holding registers. Defaults follow SunSpec model 103 with the model
# block starting at 40069. Some inverters are off by one; check the inverter's Modbus map.
MODBUS_REG_W=40083
MODBUS_REG_W_SF=40084
MODBUS_REG_HZ=40085
MODBUS_REG_HZ_SF=40086
MODBUS_REG_V=40079
MODBUS_REG_V_SF=40082
MODBUS_REG_WH=40093
MODBUS_REG_WH_SF=40095
MODBUS_REG_TEMP=40102
MODBUS_REG_TEMP_SF=40106

# --- MQTT ------------------------------------------------------------------------------------------------
MQTT_URL=mqtt://192.168.1.10:1883
MQTT_TOPIC=home/solar/inverter
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_POWER_FIELD=power_w
MQTT_ENERGY_FIELD=energy_wh_total
MQTT_TS_FIELD=ts

# --- Simulator (test data only; register the device with protocol "Simulator") --------------------------
SIM_CAPACITY_KW=3
SIM_LATITUDE=17.385
SIM_LONGITUDE=78.4867
